config {
  type: "incremental",
  name: "dim_geography",
  description: "Lưu trữ thông tin địa lý cố định của khu vực (County-level)",
  clusterBy: ["state_code", "county_fips"],
  uniqueKey: ["county_fips"], // Định nghĩa Khóa chính để Dataform tự động tạo mệnh đề MERGE
  tags: ["daily_run", "dimension"],
  assertions: {
    uniqueKey: ["county_fips"],
    nonNull: ["county_fips", "county_name", "state_code"]
  }
}

SELECT
  county_fips,
  county_name,
  state_code,
  state_name,
  hrr_region,
  area_km2,
  CURRENT_TIMESTAMP() AS ingestion_timestamp,
  TRUE AS is_active
FROM
  ${ref("stg_dim_geography")}

${  when(incremental(), 
    -- Mệnh đề này đảm bảo khi chạy incremental, Dataform chỉ quét dữ liệu stg của ngày hôm đó
    `WHERE TRUE` 
) }
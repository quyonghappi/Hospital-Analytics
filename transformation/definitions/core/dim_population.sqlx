-- transformation/definitions/core/dim_population.sqlx
config {
  type: "table",
  name: "dim_population",
  description: "Dữ liệu dân số và y tế theo hạt và năm",
  clusterBy: ["county_fips"],
  tags: ["yearly_run", "dimension"],
  assertions: {
    uniqueKey: ["county_fips", "census_year"],
    nonNull: ["county_fips", "census_year"]
  }
}

SELECT
  population_sk,
  county_fips,
  census_year,
  total_population,
  pop_65_plus_pct,
  population_density,
  median_household_income,
  poverty_rate_pct,
  uninsured_rate_pct,
  physicians_per_100k,
  nurses_per_100k,
  rucc_code,
  rucc_description,
  metro_nonmetro_flag
FROM ${ref("stg_dim_population")}
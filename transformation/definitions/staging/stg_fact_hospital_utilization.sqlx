config {
  type: "table",
  schema: "hospital_staging",
  name: "stg_fact_hospital_utilization",
  description: "Bảng Staging vật lý, lưu trữ delta data 7 ngày gần nhất để chuẩn bị Merge vào Fact",
  tags: ["daily_run", "staging"],
  assertions: {
    uniqueKey: ["fact_id"],
    nonNull: ["fact_id", "hospital_id", "report_date"]
  }
}

SELECT
  -- Optimize cho MERGE: Hash UUID string thành INT64
  FARM_FINGERPRINT(CAST(fact_id AS STRING)) AS fact_id, 
  hospital_id,
  CAST(report_date AS DATE) AS report_date,
  CAST(staffed_beds AS INT64) AS staffed_beds,
  CAST(beds_in_use AS INT64) AS beds_in_use,
  CAST(icu_beds_total AS INT64) AS icu_beds_total,
  CAST(icu_beds_in_use AS INT64) AS icu_beds_in_use,
  CAST(patient_admissions AS INT64) AS patient_admissions,
  CAST(patient_discharges AS INT64) AS patient_discharges,
  CAST(occupancy_rate AS FLOAT64) AS occupancy_rate,
  COALESCE(CAST(staffing_shortage_flag AS BOOLEAN), FALSE) AS staffing_shortage_flag,
  source_id,
  CURRENT_TIMESTAMP() AS ingestion_timestamp,
  'v1.0' AS pipeline_version
FROM
  ${ref("ext_fact_hospital_utilization")}
WHERE 
  -- Hive partition pruning base STRICTLY on execution_date
  report_date >= DATE_SUB(DATE('${dataform.projectConfig.vars.execution_date}'), INTERVAL 7 DAY)
  AND report_date <= DATE('${dataform.projectConfig.vars.execution_date}')
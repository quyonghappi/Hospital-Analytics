-- transformation/definitions/staging/stg_dim_population.sqlx
config {
  type: "view",
  schema: "hospital_staging",
  name: "stg_dim_population",
  tags: ["daily_run", "staging"],
  assertions: {
    uniqueKey: ["population_sk"],
    nonNull: ["county_fips", "census_year"]
  }
}

WITH raw_external AS (
  SELECT
    county_fips,
    CAST(census_year AS INT64)             AS census_year,
    CAST(total_population AS INT64)        AS total_population,
    CAST(pop_65_plus_pct AS FLOAT64)       AS pop_65_plus_pct,
    CAST(population_density AS FLOAT64)    AS population_density,
    CAST(median_household_income AS FLOAT64) AS median_household_income,
    CAST(poverty_rate_pct AS FLOAT64)      AS poverty_rate_pct,
    CAST(uninsured_rate_pct AS FLOAT64)    AS uninsured_rate_pct,
    CAST(physicians_per_100k AS FLOAT64)   AS physicians_per_100k,
    CAST(nurses_per_100k AS FLOAT64)       AS nurses_per_100k,
    CAST(rucc_code AS INT64)               AS rucc_code,
    rucc_description,
    _FILE_NAME AS source_file_path
  FROM ${ref("ext_dim_population")}
  WHERE
    exec_date = '${dataform.projectConfig.vars.data_date}' 
),

deduplicated AS (
  SELECT *
  FROM raw_external
  QUALIFY ROW_NUMBER() OVER(
    PARTITION BY county_fips, census_year
    ORDER BY source_file_path DESC
  ) = 1
)

SELECT
  FARM_FINGERPRINT(CONCAT(county_fips, '_', CAST(census_year AS STRING))) AS population_sk,
  TRIM(county_fips)          AS county_fips,
  census_year,
  total_population,          -- NULL = unknown, không COALESCE 0
  pop_65_plus_pct,
  population_density,
  median_household_income,
  poverty_rate_pct,
  uninsured_rate_pct,
  physicians_per_100k,
  nurses_per_100k,
  rucc_code,
  rucc_description,
  -- Derived: rural/urban flag từ RUCC (1-3 = metro, 4-9 = non-metro)
  CASE
    WHEN rucc_code BETWEEN 1 AND 3 THEN 'Metro'
    WHEN rucc_code BETWEEN 4 AND 9 THEN 'Non-Metro'
    ELSE NULL
  END AS metro_nonmetro_flag
FROM deduplicated
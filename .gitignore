".vscode/" 
"__pycache__/" 

# ==========================================
# TERRAFORM
# ==========================================
# Bỏ qua local cache và provider binaries
**/.terraform/*
.terraform/
*.tfstate
*.tfstate.*

*.tfstate.backup
.terraform.lock.hcl  # Chỉ giữ nếu team cần lock version provider

# Bỏ qua crash logs
crash.log
crash.*.log

*.tfvars
*.tfvars.json

override.tf
override.tf.json
*_override.tf
*_override.tf.json

!*.example.tfvars
!terraform.tfvars.example

# ==========================================
# PYTHON & DATA PIPELINE
# ==========================================
# Virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# SECRETS & CREDENTIALS
# ==========================================
# Dataform / GCP Local Credentials
.dataform/credentials.json
*.json
!*.schema.json # Vẫn cho phép push file định nghĩa schema nếu có
.gcp/
orchestration/.astro/config.yaml

# Environment variables
.env
.env.local


# Local Dev
docker-compose.override.yml

# ==========================================
# GCP & DATA SPECIFIC
# ==========================================
bin/
gen/
*.db
*.log

# Dataform artifacts
.dataform/
packages/
node_modules/

# Airflow/Astro local artifacts
.astro/
airflow.db
airflow.cfg
logs/
unittests.log

# Vertex AI / Notebooks
.ipynb_checkpoints
.pytest_cache/
